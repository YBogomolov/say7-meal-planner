{
  "name": "say7-meal-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly meal planner built on say7.info recipes (personal, non-commercial use).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scrape": "tsx src/scraper/cli.ts",
    "parse": "tsx src/parser/cli.ts",
    "enrich": "tsx src/enrich/cli.ts",
    "enrich:eval": "tsx src/enrich/eval-cli.ts",
    "fixtures:refresh": "tsx src/parser/fixtures-cli.ts",
    "items:report": "tsx src/planner/items-cli.ts",
    "servings:report": "tsx src/planner/servings-cli.ts",
    "plan:check": "tsx src/planner/plan-cli.ts",
    "shopping:text": "tsx src/planner/shopping-text-cli.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@effect/platform-node": "4.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.3",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@effect/tsgo": "0.53.4"
  }
}
